+
+void vglForceGarbageCollection(void) {
+    // glDeleteTextures/glDeleteFramebuffers defer their backing allocations
+    // for several swaps. A room transition can delete and replace dozens of
+    // atlases before another swap happens, so those pending allocations used
+    // to overlap the destination room and exhaust every mapped pool. Once GXM
+    // is idle all purge generations are safe to reclaim immediately.
+    if (!gxm_initialized) return;
+    // Do not use glFinish here: it calls scene_reset, which opens another
+    // scene and can enqueue scissor draws. sceGxmFinish only waits for
+    // submitted scenes; that newly opened scene would survive the purge.
+    // Leave scene creation to the next draw, after all retired data is freed.
+    if (needs_end_scene) {
+        scene_end();
+        needs_end_scene = GL_FALSE;
+    }
+    needs_scene_reset = GL_TRUE;
+    sceGxmFinish(gxm_context);
+#ifdef HAVE_SINGLE_THREADED_GC
+    // Use vitaGL's own generation rotation instead of walking every backing
+    // array manually. Besides preserving the producer/clean indices, this
+    // only visits the populated prefix of each generation and avoids freeing
+    // stale entries left beyond its terminator.
+    for (int generation = 0; generation < FRAME_PURGE_FREQ; ++generation)
+        garbage_collector(0, NULL);
+    return;
+#else
+    // gc_mutex[1] is a counting semaphore with one token per purge
+    // generation, not a binary mutex. Taking a single token did not exclude
+    // the worker: it could free a texture concurrently with this loop, which
+    // corrupted the mspace accounting during repeated room transitions.
+    // Acquire every token so no asynchronous collection can be active while
+    // the fully-idle GXM queue is drained.
+    sceKernelWaitSema(gc_mutex[1], FRAME_PURGE_FREQ, NULL);
+    for (int generation = 0; generation < FRAME_PURGE_FREQ; ++generation) {
+        for (int i = 0; i < FRAME_PURGE_LIST_SIZE; ++i) {
+            if (frame_purge_list[generation][i] == NULL) continue;
+            vgl_free(frame_purge_list[generation][i]);
+            frame_purge_list[generation][i] = NULL;
+        }
+        for (int i = 0; i < FRAME_PURGE_RENDERTARGETS_LIST_SIZE; ++i) {
+            if (frame_rt_purge_list[generation][i] == NULL) continue;
+            sceGxmDestroyRenderTarget(frame_rt_purge_list[generation][i]);
+            frame_rt_purge_list[generation][i] = NULL;
+        }
+    }
+    frame_elem_purge_idx = 0;
+    frame_rt_purge_idx = 0;
+    sceKernelSignalSema(gc_mutex[1], FRAME_PURGE_FREQ);
+#endif
+}
