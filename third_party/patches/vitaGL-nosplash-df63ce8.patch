+GLboolean vglReserveInternalUniformBuffer(GLboolean fragment, void **buffer) {
+    // GXM can reject a reservation (e.g. after a failed scene setup). Never
+    // pass the caller's uninitialised stack value to sceGxmSetUniformDataF.
+    *buffer = NULL;
+    int result = fragment ? sceGxmReserveFragmentDefaultUniformBuffer(gxm_context, buffer) :
+                            sceGxmReserveVertexDefaultUniformBuffer(gxm_context, buffer);
+    if (result < 0 || *buffer == NULL) {
+        last_internal_uniform_error = result < 0 ? result : (int)SCE_GXM_ERROR_RESERVE_FAILED;
+        vgl_error = GL_OUT_OF_MEMORY;
+        return GL_FALSE;
+    }
+    return GL_TRUE;
+}
